<!DOCTYPE html>
<html lang="kk">
<head>
  <meta charset="UTF-8" />
  <title>Кіру - Фишингке қарсы анализатор</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="container">
    <h1>Кіру</h1>
    <% if (error) { %>
      <div class="block danger"><%= error %></div>
    <% } %>
    <form action="/login" method="POST">
      <label for="username">Пайдаланушы аты:</label>
      <input type="text" name="username" id="username" required />

      <label for="password">Құпия сөз:</label>
      <input type="password" name="password" id="password" required />

      <button type="submit">Кіру</button>
    </form>
    <p>Жаңа пайдаланушы? <a href="/register">Тіркелу</a></p>
    <p><a href="/">← Басты бет</a></p>
  </div>
</body>
</html>
